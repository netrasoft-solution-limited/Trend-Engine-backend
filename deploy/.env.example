# Copy to .env and fill in. Never commit .env.
#
# PRD §7.1: secrets outside source control, separate production and development
# credentials. PRD §7.5: no payment card or bank data anywhere in this system —
# the processor key below authorises tokenized charges and nothing else.

# ── The two origins ─────────────────────────────────────────────────────────
# The planes are split by ORIGIN, not by path (Arch §5.3 as amended):
#
#   https://ops.${SITE_DOMAIN}/     operator plane
#   https://${SITE_DOMAIN}/portal/  tenant plane
#
# BOTH NAMES NEED A DNS A RECORD pointing at this host before Caddy can issue
# a certificate for either. The `ops.` record is the one that gets forgotten,
# and the symptom is a TLS failure on a host nobody has tried yet.
SITE_DOMAIN=trend.example.com
ACME_EMAIL=ops@example.com

# Restrict the operator plane before launch — PRD §7.1 calls it "private /
# identity-aware; not public". Comma-separated CIDRs. The matcher in the
# Caddyfile stays commented out until this is set: an empty allowlist would
# lock out everyone, including whoever is deploying.
OPS_ALLOWED_IPS=

DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=trend.example.com
LOG_LEVEL=INFO

# Each plane validates its OWN Host header and its own CSRF origin. These are
# separate from DJANGO_ALLOWED_HOSTS because the two processes answer on two
# different names — leaving them blank makes the plane fall back to the shared
# list, which will not contain the ops subdomain.
#
# CSRF_TRUSTED_ORIGINS needs the SCHEME; ALLOWED_HOSTS must not have one. That
# asymmetry is Django's, and mixing them up produces a 400 on every POST with
# a message that does not mention the setting.
OPS_ALLOWED_HOSTS=ops.trend.example.com
OPS_TRUSTED_ORIGINS=https://ops.trend.example.com
PORTAL_ALLOWED_HOSTS=trend.example.com
PORTAL_TRUSTED_ORIGINS=https://trend.example.com

POSTGRES_DB=trend_engine
POSTGRES_USER=trend_engine
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Self-service organisation registration (a recorded deviation from PRD §6.8 —
# see README.md). 1 lets anyone create an organisation that becomes ACTIVE as
# soon as its admin verifies their email, with no operator approval. 0 makes
# the register endpoint answer 404.
PORTAL_ALLOW_SELF_SIGNUP=0

# Public origin of the client portal (the React app), no trailing slash needed.
# Every link the portal emails is built from it: invitations
# (/portal/accept-invite/<token>) and password resets
# (/portal/reset-password/<uid>/<token>). Unset, it falls back to
# http://localhost:5173 — so production MUST set it, or every emailed link
# points at a developer's machine.
PORTAL_PUBLIC_URL=https://trend.example.com

# Object storage — off-box (Arch §11.1).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# Off-box backup target. Arch §11.3: an untested backup is not a backup —
# scripts/restore_test.sh runs weekly against a disposable database.
BACKUP_TARGET=

# Encrypts the vendor credentials stored in the database, so that a key can be
# rotated from /ops/sources/providers/ without a deploy. Generate one with:
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# SET THIS EXPLICITLY IN PRODUCTION. Left blank it is derived from
# DJANGO_SECRET_KEY, which works but ties the two together: rotating the secret
# key then makes every stored credential unreadable and they must be re-entered.
CREDENTIALS_ENCRYPTION_KEY=

# Acquisition vendors. Each needs a recorded provider policy before its
# connector may run at all (PRD §7.2).
#
# THESE ARE NOW A FALLBACK, not the primary home. Credentials live encrypted in
# the database so an operator can rotate them at /ops/sources/providers/; the
# variables below are read only when nothing is stored, which covers the first
# deploy and CI. To move what is already here into the database:
#
#   python manage.py set_provider_credential apify --from-env
#
# Once stored, the database value wins and these can be emptied.
TADDY_API_KEY=
TADDY_USER_ID=
APIFY_TOKEN=
APIFY_WEBHOOK_SECRET=
ASSEMBLYAI_API_KEY=
YOUTUBE_API_KEY=
NCBI_API_KEY=

# LLM. Arch §10.3 carries $180–250/month as a budget RESERVE, not a measured
# cost. Tiered by task: cheap tier for relevance classification, stronger tier
# only for client-facing drafting.
LLM_API_KEY=
LLM_MONTHLY_CAP_USD=350

# A single call this expensive is a bug — a runaway prompt, or a document
# pasted into a classifier. Refused before it is made (Arch §10.2).
LLM_PER_CALL_MAX_USD=1.00

# Tiered by task (Arch §10.3). Override to re-point a tier when a price or a
# capability changes, without a deploy.
LLM_MODEL_GATE=claude-haiku-4-5
LLM_MODEL_EXTRACTION=claude-sonnet-5-5
LLM_MODEL_DRAFTING=claude-opus-5-5

# Outbound email, over SMTP (config/settings/mail.py). PRD §13 leaves the
# provider open; any provider with SMTP works. Blank counts as unset.
#
# With DJANGO_EMAIL_BACKEND unset the CONSOLE backend is used, in production
# too: nothing is sent, and every email — invitation, password-reset and
# verification links included, one-time tokens and all — is written to the
# process log. Startup logs a warning when that happens with DEBUG off.
#
#   DJANGO_EMAIL_BACKEND  django.core.mail.backends.smtp.EmailBackend to send;
#                         ...dummy.EmailBackend to discard without logging
#   EMAIL_HOST            provider's SMTP host              (default localhost)
#   EMAIL_PORT            usually 587 with STARTTLS          (default 25)
#   EMAIL_HOST_USER       SMTP username                      (default empty)
#   EMAIL_HOST_PASSWORD   SMTP password — a SECRET; set it in the host's
#                         secret store, never in a committed file
#   EMAIL_USE_TLS         1/0, true/false, yes/no, on/off     (default off)
#   DEFAULT_FROM_EMAIL    the From: header on every message
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Trend Engine <no-reply@example.com>

# Open decisions (PRD §13) — unset until chosen.
STRIPE_SECRET_KEY=
# Not read by any code. SMTP credentials go in EMAIL_HOST_USER and
# EMAIL_HOST_PASSWORD above.
EMAIL_PROVIDER_API_KEY=
